{
  "name": "decision-maker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "purge:css": "purgecss --config purgecss.config.js --output ./clean-css",
    "test": "vitest run",
    "e2e": "playwright test",
    "import:travel": "node scripts/importTravelKml.js",
    "append:travel": "node scripts/appendTravelKml.js",
    "update:geo": "node scripts/addGeoMetadata.js",
    "monitor:temp": "node scripts/tempAlert.js",
    "generate:geoscore": "node scripts/generateGeoscoreData.js",
    "generate:countries": "node scripts/generateCountriesJsonFromNE.js",
    "geoscore:apply-country-scores": "node scripts/applyCountryScores.js",
    "geoscore": "npm run geoscore:apply-country-scores",
    "geoscore:append-states": "node scripts/appendStateCitiesToGeoscore.js",
    "fetch:topo": "node scripts/fetchTopoLines.js",
    "fetch:borders": "node scripts/fetchCountryBorders.js",
    "gen:topo": "node scripts/generateTopoLines.js --step-deg=0.75 --both",
    "fetch:elevation": "node scripts/fetchElevationContours.js --zoom=8 --interval=500",
    "fetch:rivers": "node scripts/fetchRiversToGeoJSON.js",
    "generate:flags": "node scripts/generateFlagsMetadata.js",
    "generate:world-cities": "node scripts/generateWorldCitiesList.js",
    "generate": "npm run generate:countries && npm run generate:flags && npm run generate:tiles",
    "prepare": "husky install",
    "start": "node backend/server.js",
    "generate:tiles": "node scripts/generateVectorTiles.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mapbox/mbtiles": "^0.12.1",
    "@turf/turf": "^6.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^4.5.3",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.6.0",
    "pngjs": "^7.0.0",
    "twilio": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "husky": "^8.0.0",
    "jsdom": "^26.1.0",
    "purgecss": "^7.0.2",
    "supertest": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
